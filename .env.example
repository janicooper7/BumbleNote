# --- Database (Neon Postgres) ---
# Get this from https://console.neon.tech -> your project -> Connection Details.
# Use the POOLED connection string (host contains "-pooler") for the app runtime;
# serverless functions open many short-lived connections.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/bumblenote?sslmode=require"

# --- Auth (NextAuth v5 / Auth.js — Google) ---
# A random secret used to sign session JWTs. Generate one with:
#   npx auth secret        (writes it for you)  — or —  openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth credentials. Create them at:
#   https://console.cloud.google.com/apis/credentials
#   -> Create OAuth client ID -> Web application
# Authorized redirect URI (add both if you deploy):
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI (Anthropic Claude) ---
# Generates structured lesson feedback from a transcript (see src/lib/ai.ts).
# Create a key at https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=""

# --- Email (Resend) ---
# Sends the lesson-report PDF to the student on "Confirm & send".
# Create a key at https://resend.com -> API Keys.
RESEND_API_KEY=""
# From address. REQUIRED BEFORE LAUNCH. Left empty, sending falls back to Resend's
# shared sandbox sender (onboarding@resend.dev), which only delivers to your own
# Resend account email — every real student send fails with a 403. To fix:
#   1. resend.com/domains -> Add domain (a sending subdomain like mail.bumblenote.com
#      is the usual choice, and is what this project uses — NOT the apex domain)
#   2. add the DKIM/SPF records it gives you at your DNS host, wait for "Verified"
#   3. set this to an address on THAT EXACT domain, e.g.
#      "BumbleNote <noreply@mail.bumblenote.com>" — the apex is a different domain
#      as far as Resend is concerned and will 403 if only the subdomain is verified.
#      Set it in .env.local AND in Netlify's environment variables.
EMAIL_FROM=""
# From address for waitlist/launch emails (src/lib/waitlist-welcome.ts). Optional:
# empty falls back to EMAIL_FROM. Same verified-domain rule applies, e.g.
# "BumbleNote <hello@mail.bumblenote.com>".
MARKETING_EMAIL_FROM=""

# The site's public origin, used to build absolute links in emails (the
# password-reset link) and, via SITE_URL in src/lib/app-url.ts, the canonical
# tags, sitemap.xml and social-card URLs. Set it in production. Left empty, the
# email origin is read from the request's Host header, which a crafted request
# can spoof — that's how a reset email ends up pointing at somebody else's
# domain — and the SEO metadata falls back to the hardcoded production domain.
#   e.g. APP_URL="https://bumblenote.com"
APP_URL=""

# --- Speech-to-text (Deepgram) ---
# Transcribes the two lesson audio tracks (student + tutor) into a labelled
# transcript. Create a key at https://console.deepgram.com -> API Keys.
DEEPGRAM_API_KEY=""

# --- Billing (Stripe) ---
# Subscriptions for the paid plans (src/lib/billing.ts). Use TEST keys (sk_test_…)
# locally and on anything that isn't the production site: Stripe dashboard →
# toggle "Test mode" → Developers → API keys. Live keys go ONLY in Netlify's
# production environment.
# Then create the products and prices once per mode:  npm run stripe:setup
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint (whsec_…). In production: Developers →
# Webhooks → your https://bumblenote.com/api/stripe/webhook endpoint. Locally:
# the secret printed by  stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# --- Internal task secret ---
# Shared secret that lets /api/upload/complete trigger the background processing
# function (netlify/functions/process.mts) and nobody else — the function's URL is
# public. Generate any random string, e.g.  openssl rand -hex 32
INTERNAL_TASK_SECRET=""

# --- Operator allowlist ---
# Comma-separated emails allowed to use /api/admin/recover, which is cross-tenant
# (it lists and re-runs failed uploads for ANY tutor). Matched against the Google
# account you sign in with. Unset = nobody, and the routes answer 404 — the safe
# default now that anyone can sign up.
ADMIN_EMAILS="you@example.com"

# --- Operator alerts (optional but recommended in production) ---
# Where BumbleNote emails you when something breaks (src/lib/alerts.ts): a lesson
# that failed to process, a page that threw, a retention sweep that didn't run.
# Sent through the same Resend account as everything else, so EMAIL_FROM has to
# be a verified sender for these to arrive.
#
# Leave empty to fall back to the first address on ADMIN_EMAILS. Empty AND no
# ADMIN_EMAILS means alerting is off — nothing breaks, you just hear nothing.
#
# Volume is capped so a broken deploy can't flood the mailbox or burn the Resend
# quota: the same alert repeats at most every 15 minutes, and each trust channel
# has its own hourly ceiling — 20 for our own server code, 3 for crash reports
# from anonymous visitors. The channels are separate on purpose, so nobody can
# spend the public budget to suppress a real worker or retention alert.
ALERT_EMAIL=""

# --- Pre-launch site gate (optional) ---
# One shared password that hides the whole site from the public while it's not
# launched (src/proxy.ts + src/lib/site-gate.ts). Visitors get a password page at
# /enter and, once through, a 30-day cookie. This is NOT per-user auth — tutors
# still sign in with Google afterwards.
# LEAVE EMPTY TO DISABLE THE GATE AND MAKE THE SITE PUBLIC. Changing the value
# (or AUTH_SECRET) signs everyone out of the gate.
#
# This one variable IS the launch switch. While it's set, robots.txt disallows
# everything and every page carries a noindex, so nothing can be indexed before
# launch; clearing it flips both on its own (src/app/robots.ts, src/app/layout.tsx).
# Both are baked at build time, so launching means: clear the variable AND
# redeploy — clearing it alone leaves the last build's robots.txt in place.
SITE_PASSWORD=""

# --- Lesson audio upload format ---
# How the browser uploads silence-trimmed lesson audio (src/lib/audio-trim.ts).
#   "opus" — 32 kbps Ogg Opus, ~8x smaller: a 60-minute lesson is ~15 MB instead
#            of ~115 MB. Falls back to WAV on any browser that can't encode it.
#   "wav"  — uncompressed 16 kHz WAV. The default when unset.
# Compared on Deepgram, Opus transcripts differ from WAV no more than the original
# recording's do. Baked in at build time (NEXT_PUBLIC_*), so changing it in Netlify
# only takes effect after a redeploy. The worker log shows which format arrived:
#   [process] audio assembled student=…B/ogg tutor=…B/ogg
NEXT_PUBLIC_UPLOAD_CODEC="opus"

# Copy this file to .env.local and fill in the real values:
#   cp .env.example .env.local

# ============================================================================
# Deploying to Netlify
# ============================================================================
# Lesson audio can't be POSTed in one shot on serverless (Netlify's 6 MB body
# limit + 26–60 s function timeout), so it's chunk-uploaded to Netlify Blobs and
# processed by a 15-minute background function (netlify/functions/process.mts).
# Netlify Blobs needs zero setup on a linked site, but is NOT available under a
# plain `next dev` — use `netlify dev` to exercise the pipeline locally.
#
# In Netlify -> Site configuration -> Environment variables, set ALL of the keys
# above (DATABASE_URL, AUTH_SECRET, AUTH_GOOGLE_ID/SECRET, ANTHROPIC_API_KEY,
# RESEND_API_KEY, EMAIL_FROM, DEEPGRAM_API_KEY, INTERNAL_TASK_SECRET, ADMIN_EMAILS),
# plus ALERT_EMAIL if you want to be emailed about failures,
# plus SITE_PASSWORD if you want the pre-launch gate on, plus:
#
#   AUTH_TRUST_HOST=true   # also pinned in netlify.toml; required or Google
#                          # sign-in redirects break behind Netlify's proxy.
#
# Then in Google Cloud Console -> Credentials -> your OAuth client, add the
# deployed callback to Authorized redirect URIs:
#   https://YOUR-SITE.netlify.app/api/auth/callback/google
#
# The capture extension is already URL-configurable: open its popup and set the
# app URL to your Netlify site — no rebuild needed.
